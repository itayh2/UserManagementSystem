@model UserManagementSystem.Models.User

@{
	ViewBag.Title = "Delete User";
}

<div class="container mt-4">
	<div class="row justify-content-center">
		<div class="col-md-6">
			<div class="card border-danger">
				<div class="card-header bg-danger text-white">
					<h4 class="mb-0">Delete User</h4>
				</div>
				<div class="card-body text-center">
					<div mb-4>
						<i class="bi-exclamation-triangle text-danger" style="font-size:3rem"></i>
					</div>
					<p class="mb-4">
						Are you sure you want to delete the user <strong>@Model.UserName</strong>?
					</p>
					<p class="text-muted mb-4">This action cannot be undone</p>
					<form asp-action="Delete" method="post">
						<input type="hidden" asp-for="UserId" />
						<div class="d-grid gap-2 d-md-flex justify-content-md-center">
							<a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
							<button type="submit" class="btn btn-danger">Delete</button>
						</div>
					</form>
				</div>
			</div>
		</div>
	</div>
</div>

